{
	"name": "svelte-excalidraw-app",
	"private": true,
	"description": "A full-stack whiteboard application built with SvelteKit, embedding Excalidraw's React component within a Svelte app to demonstrate cross-framework integration. Features user authentication, persistent workspaces saved to a server database, and lazy-loaded React rendering isolated from the Svelte runtime.",
	"version": "1.0.0",
	"author": "Nyasper",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "bun run build && wrangler deploy --secrets-file .env.production",
		"dev:cf": "bun run build && wrangler dev --port 8787",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:start": "docker compose up -d",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/node": "24",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "3.22.0",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "5.56.8",
		"svelte-check": "4.7.5",
		"typescript": "6",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.43.0"
	},
	"dependencies": {
		"@better-auth/utils": "0.4.2",
		"@excalidraw/excalidraw": "^0.18.1",
		"better-auth": "~1.6.26",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"resend": "^6.18.1"
	}
}
