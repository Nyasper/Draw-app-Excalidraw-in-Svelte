# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Better Auth — base URL for OAuth callbacks, email verification, and password reset links.
# Required in production: set to your deployed domain (e.g., https://myapp.vercel.app).
# Must be a full URL with protocol, no trailing slash.
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Resend
# https://resend.com/api-keys
RESEND_API_KEY=""
MY_DOMAIN=""

# GitHub OAuth — dev (localhost)
# Callback URL registrado en esta app: http://localhost:5173/api/auth/callback/github
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub OAuth — producción
# GitHub solo permite un callback URL por app; crea una app OAuth aparte para producción.
# Callback URL registrado: https://<tu-dominio>/api/auth/callback/github
GITHUB_CLIENT_ID_PROD=""
GITHUB_CLIENT_SECRET_PROD=""
